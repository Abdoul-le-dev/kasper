# Copier ce fichier en ".env" et remplir les valeurs réelles.
# Ne jamais committer le fichier ".env" réel dans un dépôt git.

# --- Claude API (décideur de chaque cycle) ---
# Clé obtenue sur https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=colle_ta_cle_api_anthropic_ici
# Modèle Claude à utiliser (par défaut: claude-opus-4-8)
CLAUDE_MODEL=claude-opus-4-8
# Timeout d'un appel Claude en secondes (par défaut: 30)
CLAUDE_TIMEOUT_SECONDS=30

# --- MetaApi.cloud (wrapper API du compte MT5 chez XM) ---
# Créer un compte sur https://app.metaapi.cloud, y ajouter ton compte MT5 XM,
# puis générer un token depuis la section "API tokens".
METAAPI_TOKEN=colle_ton_token_metaapi_ici
METAAPI_ACCOUNT_ID=uuid_du_compte_mt5_deploye_sur_metaapi
# "new-york" (par défaut), "london" ou "singapore"
METAAPI_REGION=new-york
# Symbole XAUUSD tel que défini par ton broker (XM: "GOLD" sur certains
# comptes, "XAUUSD" sur d'autres — vérifier dans MT5 > Market Watch)
METAAPI_SYMBOL=XAUUSD

# --- Telegram (notifications en temps réel) ---
TELEGRAM_BOT_TOKEN=colle_ton_token_bot_ici
TELEGRAM_CHAT_ID=colle_ton_chat_id_ici
# "true" pour aussi recevoir une notification à chaque HOLD (toutes les 30 min)
TELEGRAM_NOTIFY_HOLD=false

# --- Moteur de décision (API locale) ---
ENGINE_BASE_URL=http://127.0.0.1:8000

# --- Stockage local (journal, métadonnées de position, état journalier) ---
JOURNAL_PATH=/home/ubuntu/kasper/data/journal.jsonl
POSITIONS_META_PATH=/home/ubuntu/kasper/data/positions_meta.json
DAILY_STATE_PATH=/home/ubuntu/kasper/data/daily_state.json
