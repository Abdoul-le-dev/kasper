// Source: VWAP session-based — TradingView built-in `ta.vwap()`
// Reference: https://www.tradingview.com/pine-script-reference/v5/#fun_ta{dot}vwap
//
// Definition:
//   typical  = (high + low + close) / 3
//   cum_pv   = cumsum(typical * volume) reset at each session start
//   cum_vol  = cumsum(volume) reset at each session start
//   vwap     = cum_pv / cum_vol
//
// For XAUUSD we use tick_volume as volume proxy (spec: tick volume authorized).
// Session anchor: we use daily anchor at 00:00 UTC (standard for FX/gold).
//
// Pine snippet:
//   //@version=5
//   indicator("Session VWAP", overlay=true)
//   src = (high + low + close) / 3
//   newSession = ta.change(time("D")) != 0
//   var float cumPV = 0.0
//   var float cumV  = 0.0
//   if newSession
//       cumPV := 0.0
//       cumV  := 0.0
//   cumPV := cumPV + src * volume
//   cumV  := cumV + volume
//   vwap = cumPV / cumV
//   plot(vwap)
