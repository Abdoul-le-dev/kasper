# Copier ce fichier en ".eaaaaaaaaaaaaaaaaaaaaaaaa
# Ne jamais committer ".env".

# --- MetaApi.cloud (compte démo XM) ---
METAAPI_TOKEN=colle_ton_token_ici
METAAPI_ACCOUNT_ID=uuid_du_compte_demo_xm
METAAPI_REGION=new-york
METAAPI_SYMBOL=XAUUSD

# --- Telegram (alertes paper trading) ---
TELEGRAM_BOT_TOKEN=colle_ton_token_bot_ici
TELEGRAM_CHAT_ID=colle_ton_chat_id_ici

# --- Kill switch dur ---
# NE JAMAIS augmenter cette valeur sans revalidation complète du système.
DAILY_LOSS_MAX_DOLLARS=50

# --- Interrupteur live ---
# false = paper trading uniquement (compte démo, ordres démo)
# true  = ordres réels sur compte réel — BASCULEMENT MANUEL UNIQUEMENT
LIVE_ENABLED=false
