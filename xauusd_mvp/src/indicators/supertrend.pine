// Source: Pine Script v5 built-in `ta.supertrend()` — TradingView
// Reference: https://www.tradingview.com/pine-script-reference/v5/#fun_ta{dot}supertrend
//
// Standard SuperTrend (Olivier Seban) definition:
//   src   = (high + low) / 2
//   atr   = ta.atr(length)
//   up    = src - factor * atr
//   dn    = src + factor * atr
//   up    := close[1] > up[1]  ? max(up, up[1])    : up   // stair-step up
//   dn    := close[1] < dn[1]  ? min(dn, dn[1])    : dn   // stair-step dn
//   trend := close > dn[1]     ?  1 :
//            close < up[1]     ? -1 : nz(trend[1], 1)
//   supertrend = trend == 1 ? up : dn
//   direction  = trend
//
// Pine snippet:
//   //@version=5
//   indicator("Supertrend", overlay=true)
//   length = input.int(10, "ATR Length")
//   factor = input.float(3.0, "Factor")
//   [supertrend, direction] = ta.supertrend(factor, length)
//   plot(supertrend, color = direction < 0 ? color.green : color.red)
